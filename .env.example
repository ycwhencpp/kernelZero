OPENAI_API_KEY=
OPENAI_TEXT_MODEL_FAST=gpt-5.6-luna
OPENAI_TEXT_MODEL_QUALITY=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL_QUALITY=gemini-2.5-flash
GEMINI_TEXT_MODEL_FAST=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Orus
AI_PROVIDER=auto
# Optional LinkedIn-only override. Leave blank to inherit AI_PROVIDER.
LINKEDIN_POST_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Legacy single-model fallback. The semantic podcast pipeline uses the
# role-specific settings below when they are present.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_CONTEXT_SIZE=16384
OLLAMA_SCRIPT_MODEL=redbus-gemma:latest
OLLAMA_CONSOLIDATION_MODEL=redbus-gemma:latest
OLLAMA_REVIEW_MODEL=gpt-oss-safeguard:20b
OLLAMA_METADATA_MODEL=mistral:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_SCRIPT_CONTEXT_SIZE=65536
OLLAMA_CONSOLIDATION_CONTEXT_SIZE=65536
OLLAMA_REVIEW_CONTEXT_SIZE=65536
OLLAMA_METADATA_CONTEXT_SIZE=32768
OLLAMA_DIGEST_CONTEXT_SIZE=32768
OLLAMA_SCRIPT_MAX_OUTPUT_TOKENS=8192
OLLAMA_CONSOLIDATION_MAX_OUTPUT_TOKENS=8192
OLLAMA_REVIEW_MAX_OUTPUT_TOKENS=4096
OLLAMA_METADATA_MAX_OUTPUT_TOKENS=1024
OLLAMA_DIGEST_MAX_OUTPUT_TOKENS=1024
# Total safeguard timeout, followed by one shorter retry when the first call times out.
OLLAMA_REVIEW_TIMEOUT_MS=600000
OLLAMA_REVIEW_RETRY_TIMEOUT_MS=180000
OLLAMA_SCRIPT_KEEP_ALIVE=30m
OLLAMA_CONSOLIDATION_KEEP_ALIVE=30m
OLLAMA_REVIEW_KEEP_ALIVE=0
OLLAMA_METADATA_KEEP_ALIVE=0
OLLAMA_DIGEST_KEEP_ALIVE=0
OLLAMA_EMBEDDING_KEEP_ALIVE=30m
OLLAMA_DEDUP_SIMILARITY_THRESHOLD=0.85
OLLAMA_DEDUP_PROMPT_PAIR_LIMIT=200
OLLAMA_DIGEST_AUDIT_MODE=midpoint
OLLAMA_PIPELINE_LOG_LEVEL=info
# Strict serialized evidence-packet budgets. Oversized blocks are represented
# by provenance-tagged first/middle/last excerpts rather than head truncation.
OLLAMA_PLANNING_SOURCE_MAX_CHARACTERS=24000
OLLAMA_SEGMENT_SOURCE_MAX_CHARACTERS=24000
OLLAMA_REVIEW_SOURCE_MAX_CHARACTERS=48000
OLLAMA_SEMANTIC_BLOCK_MAX_CHARACTERS=6000
OLLAMA_PARALLELISM=2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_LOG_TIMINGS=false
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=300000
OLLAMA_IDLE_TIMEOUT_MS=90000
# Selected-source full-text hydration. These limits apply before untrusted
# source material reaches a model prompt.
SOURCE_DOCUMENT_FETCH_TIMEOUT_MS=20000
SOURCE_DOCUMENT_BATCH_TIMEOUT_MS=45000
SOURCE_DOCUMENT_HTML_MAX_BYTES=5242880
SOURCE_DOCUMENT_PDF_MAX_BYTES=20971520
SOURCE_DOCUMENT_MAX_CHARACTERS=300000
SOURCE_DOCUMENT_MAX_BLOCKS=2000
SOURCE_DOCUMENT_MAX_PDF_PAGES=100
LOCAL_TTS_VOICE=
LOCAL_TTS_RATE=170
# Local Chatterbox voice cloning. The reference samples and model cache stay local.
CHATTERBOX_PYTHON=.venv-chatterbox/bin/python
CHATTERBOX_DEVICE=mps
# Optional: set this to keep model weights in a project-specific local cache.
CHATTERBOX_CACHE_DIR=
CHATTERBOX_TIMEOUT_MS=1800000
# Also bounds the slow-chunk tolerance after retries; values above 0.15 are capped.
CHATTERBOX_MAX_TEMPO_ADJUSTMENT=0.15
# Preferred raw chunk band. Clear, slightly slow chunks are retried, then retained.
CHATTERBOX_MIN_WPM=130
CHATTERBOX_MAX_WPM=190
# Optional audio-only pronunciation overrides as a JSON object.
# TTS_PRONUNCIATION_OVERRIDES={"Kubernetes":"koo-ber-NET-eez"}
LOCAL_VOICE_STORAGE_DIR=.kernelzero/voices
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PODCAST_BASE_URL=http://localhost:3000
PODCAST_EMAIL=creator@example.com
PODCAST_TITLE=KernelZero Daily
PODCAST_DESCRIPTION=Research papers and technology shifts, distilled into clear daily audio.
REQUIRE_AUTH=true
REQUIRE_LOCAL_VOICE=false
SKIP_EVIDENCE_VERIFICATION=false
DAILY_BUDGET_USD=2.00
CRON_SECRET=
CRON_OWNER_EMAIL=local@kernelzero.local
